
# --- Qdrant ---
QDRANT_HOST="localhost"
QDRANT_PORT="6333"
QDRANT_API_KEY=your_qdrant_api_key

# --- Google Gemini ---
GEMINI_API_KEY=your-api-key

# --- Vanna Configuration ---
VANNA_MODEL=gemini-2.5-flash
VANNA_TEMPERATURE=0.1
VANNA_MAX_TOKENS=2048
VANNA_EMBED_MODEL=models/embedding-001

# --- PostgreSQL Connection ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=chatbot

# --- Log Configuration ---
LOG_LEVEL=INFO

# --- Agent Models ---
ROUTER_AGENT_MODEL=gemini-2.5-pro
DOMAIN_ROUTER_MODEL=gemini-2.5-pro
EXPLAIN_AGENT_MODEL=gemini-2.5-flash
GENERAL_CHAT_MODEL=gemini-2.5-flash