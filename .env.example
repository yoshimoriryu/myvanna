# --- Google Gemini ---
GEMINI_API_KEY=your-api-key

# --- Log Configuration ---
LOG_LEVEL=INFO

# --- Qdrant ---
QDRANT_SCHEME=http
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=your_qdrant_api_key

# --- Secure Execution API ---
SECURE_API_URL=http://secure-api:8000

# --- Vanna Configuration ---
VANNA_MODEL=gemini-2.5-flash
VANNA_TEMPERATURE=0.1
VANNA_MAX_TOKENS=2048
VANNA_EMBED_MODEL=models/embedding-001

# --- Agent Models ---
ROUTER_AGENT_MODEL=gemini-2.5-flash
DOMAIN_ROUTER_MODEL=gemini-2.5-flash
EXPLAIN_AGENT_MODEL=gemini-2.5-flash
GENERAL_CHAT_MODEL=gemini-2.5-flash

# --- Private Data DB (PostgreSQL) ---
# This is the database that the Secure API connects to.
POSTGRES_HOST=private-data-db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=chatbot

# --- Chatbot State DB (PostgreSQL) ---
# This database stores the chatbot's conversation history.
CHATBOT_DB_USER=chatbot_user
CHATBOT_DB_PASSWORD=chatbot_password
CHATBOT_DB_NAME=chatbot_db
CHATBOT_DB_HOST=chatbot-state-db
CHATBOT_DB_PORT=5434
